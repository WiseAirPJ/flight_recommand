# Copy this file to backend/.env. Defaults make no paid provider requests.
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./flights.db
INIT_DB_ON_STARTUP=true
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Explicit demo mode for local UI development only. Never stored as price history.
ENABLE_DUMMY_FALLBACK=false
USE_REAL_AMADEUS=false
AMADEUS_HOSTNAME=test
# AMADEUS_CLIENT_ID=
# AMADEUS_CLIENT_SECRET=
# KOREAEXIM_API_KEY=

# Monthly results and job ownership live in the shared database.
# Start a Celery worker even for demo map searches. Production requires PostgreSQL.
# Real production provider calls also require the same Redis rate-limit database
# across API/worker processes. Without configured Redis, only local dev is supported.
# REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
COLLECTION_ORIGINS=["ICN","GMP","PUS","CJJ","TAE","CJU","MWX","YNY"]
MONTHLY_SAMPLE_STEP=3
MONTHLY_CACHE_TTL=3600
MONTHLY_STALE_TTL=604800
MONTHLY_JOB_LEASE_SECONDS=180
AMADEUS_REQUESTS_PER_SECOND=5

# Disabled when absent. Send X-Admin-Key for /api/v1/cache/*.
# ADMIN_API_KEY=
ENABLE_EXPERIMENTAL_FEATURES=false

# Production: generate your own persistent secret, set ENVIRONMENT=production,
# INIT_DB_ON_STARTUP=false, ENABLE_DUMMY_FALLBACK=false, a PostgreSQL DATABASE_URL,
# and a shared REDIS_URL for real provider calls. Apply Alembic migrations.
# SECRET_KEY=
